COMPOSE_PROJECT_NAME=nextcloud

HTTP_PORT=8080
HTTPS_PORT=8443
TLS_HOST=localhost
NEXTCLOUD_URL=https://localhost:8443
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1"

NEXTCLOUD_DATA_PATH=./data
DATABASE_DATA_PATH=./db
VAULT_PATH=./vault
TLS_CERT_PATH=./certs/tls.crt
TLS_KEY_PATH=./certs/tls.key

MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=nextcloud
MARIADB_USER=nextcloud
MARIADB_PASSWORD=change-me

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=10G

BESZEL_PORT=8090
BESZEL_URL=http://localhost:8090
BESZEL_DATA_PATH=./beszel_data
BESZEL_SOCKET_PATH=./beszel_socket
